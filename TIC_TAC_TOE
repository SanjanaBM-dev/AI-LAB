board = ['1','2','3','4','5','6','7','8','9']

def display():
    print()
    print(board[0], "|", board[1], "|", board[2])
    print("--+---+--")
    print(board[3], "|", board[4], "|", board[5])
    print("--+---+--")
    print(board[6], "|", board[7], "|", board[8])

def check_win():
    win = [
        [0,1,2], [3,4,5], [6,7,8],
        [0,3,6], [1,4,7], [2,5,8],
        [0,4,8], [2,4,6]
    ]

    for a, b, c in win:
        if board[a] == board[b] == board[c]:
            return True

    return False

player = 'X'
turn = 0

while turn < 9:
    display()

    choice = int(input("Player " + player + ", enter position: "))

    if choice < 1 or choice > 9:
        print("Invalid position! Try again.")
        continue

    index = choice - 1

    if board[index] == 'X' or board[index] == 'O':
        print("Position already occupied! Try again.")
        continue

    board[index] = player
    turn += 1

    if check_win():
        display()
        print("Player", player, "wins!")
        break

    if player == 'X':
        player = 'O'
    else:
        player = 'X'

else:
    display()
    print("Game Draw!")

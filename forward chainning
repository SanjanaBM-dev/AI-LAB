
# Forward Chaining in First Order Logic

# Step 1: Initial facts
facts = {
    ("American", "Robert"),
    ("Enemy", "A", "America"),
    ("Owns", "A", "T1"),
    ("Missile", "T1")
}

# Step 2: Apply inference rules
changed = True

while changed:
    changed = False

    # Rule 1: All missiles are weapons
    for fact in list(facts):
        if fact[0] == "Missile":
            new_fact = ("Weapon", fact[1])

            if new_fact not in facts:
                facts.add(new_fact)
                print("Derived:", new_fact)
                changed = True

    # Rule 2: Robert sells missiles owned by A
    for fact in list(facts):
        if fact[0] == "Missile":
            x = fact[1]

            if ("Owns", "A", x) in facts:
                new_fact = ("Sells", "Robert", x, "A")

                if new_fact not in facts:
                    facts.add(new_fact)
                    print("Derived:", new_fact)
                    changed = True

    # Rule 3: Enemy of America is hostile
    for fact in list(facts):
        if fact[0] == "Enemy" and fact[2] == "America":
            new_fact = ("Hostile", fact[1])

            if new_fact not in facts:
                facts.add(new_fact)
                print("Derived:", new_fact)
                changed = True

    # Rule 4: American selling weapons to hostile
    # nations is a criminal
    if (("American", "Robert") in facts and
        ("Weapon", "T1") in facts and
        ("Sells", "Robert", "T1", "A") in facts and
        ("Hostile", "A") in facts):

        new_fact = ("Criminal", "Robert")

        if new_fact not in facts:
            facts.add(new_fact)
            print("Derived:", new_fact)
            changed = True

# Step 3: Display result
print("\nFinal Result:")

if ("Criminal", "Robert") in facts:
    print("Robert is a Criminal")
else:
    print("Cannot prove Robert is a Criminal")


from itertools import product

def implies(a, b):
    return not a or b

def check_kb(P, Q, R):
    s1 = implies(Q, P)
    s2 = implies(P, not Q)
    s3 = Q or R
    return s1 and s2 and s3

def check_entailment(symbols, kb, query):
    models = []

    for values in product([False, True], repeat=len(symbols)):
        model = dict(zip(symbols, values))

        P = model['P']
        Q = model['Q']
        R = model['R']

        s1 = implies(Q, P)
        s2 = implies(P, not Q)
        s3 = Q or R

        kb_value = kb(P, Q, R)
        query_value = query(P, Q, R)

        print(model, s1, s2, s3, kb_value, query_value)

        if kb_value:
            models.append(model)

    return models

symbols = ['P', 'Q', 'R']

print("P Q R | Q->P | P->~Q | QvR | KB")

models = check_entailment(
    symbols,
    check_kb,
    lambda P, Q, R: True
)

print("\nModels of KB:")
for m in models:
    print(m)

queries = {
    "R": lambda P, Q, R: R,
    "R -> P": lambda P, Q, R: implies(R, P),
    "Q -> R": lambda P, Q, R: implies(Q, R)
}

for name, query in queries.items():
    result = all(query(m['P'], m['Q'], m['R']) for m in models)
    print("KB entails", name, ":", result)
